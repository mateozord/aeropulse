# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — it will never be committed or pushed.

# Supabase project settings → API. Used by the browser app (read-only,
# safe to expose — access is restricted by Row Level Security).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only needed if you're running scripts/captureSnapshot.ts locally to test
# it. SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security — treat it like
# a database password. In production this pair lives as GitHub Actions repo
# secrets (Settings → Secrets and variables → Actions), never in a file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio (Gemini API) key for the "Explain this signal" feature.
# Free tier, no credit card — https://aistudio.google.com/apikey. Read only
# by the dev-server proxy (server/geminiDevProxy.ts), never sent to the
# browser. In production this needs a real serverless function (Fase 13).
GEMINI_API_KEY=
